# DIKO 凭据模板（发布版全空 · 红线：本文件随技能分发时不得含任何个人信息）
# 首次使用时交互式询问用户名/密码并写入本文件；登入成功后自动写入 REFRESH 字段。
# 无账号请先走 diko-use 注册模块（register.py validate → 用户确认 → submit），或到 www.dikoai.cn 注册。
DIKO_BASE_URL=https://www.dikoai.cn
DIKO_USERNAME=
DIKO_PASSWORD=
DIKO_REFRE...ME=

# 生图默认参数（/api/z_maxgen/）
DIKO_IMAGE_MODEL=无限生图3.1flash
DIKO_IMAGE_RESOLUTION=2K

# 注册模块额度预检查：每小时最多尝试次数
DIKO_REGISTER_MAX_PER_HOUR=3
